<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
        Android 12+ masks splash icons. Keep the complete branded artwork inside the
        2/3 safe zone of a 240dp splash-icon canvas so none of its edges are clipped.
    -->
    <item
        android:width="240dp"
        android:height="240dp"
        android:gravity="center">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
    <item
        android:drawable="@drawable/simple_text_message_app_icon"
        android:width="160dp"
        android:height="160dp"
        android:gravity="center" />
</layer-list>
